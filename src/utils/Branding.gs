// ── BRANDED PDF REPORTS ───────────────────────────────────────────────────────
// One layout for member statements and admin reports: club seal, navy header band,
// summary cards and striped tables. Built as a Google Doc, exported to PDF.

const BRAND_INK    = '#1d2b3a';
const BRAND_SOFT   = '#eef3f8';
const BRAND_STRIPE = '#f6f9fc';
const BRAND_LINE   = '#d5e0ec';
const BRAND_MUTED  = '#5b6b7d';

function _logoBlob() {
  return Utilities.newBlob(Utilities.base64Decode(CLUB_LOGO_B64), 'image/jpeg', 'club-seal.jpg');
}

// Builds a branded document with buildFn(body) and returns the PDF blob
function _brandedPdf(fileTitle, subtitle, buildFn) {
  const doc = DocumentApp.create(fileTitle);
  const body = doc.getBody();
  body.setMarginLeft(40); body.setMarginRight(40); body.setMarginTop(30); body.setMarginBottom(30);
  body.editAsText().setFontFamily('Arial').setFontSize(10).setForegroundColor(BRAND_INK);
  _brandHeader(body, subtitle);
  buildFn(body);
  const foot = body.appendParagraph('Generated ' + today() + '  |  ' + SACCO_NAME + '  |  Confidential: for members and the committee only.');
  foot.setSpacingBefore(18);
  foot.editAsText().setFontSize(8).setForegroundColor(BRAND_MUTED);
  doc.saveAndClose();
  const file = DriveApp.getFileById(doc.getId());
  const blob = file.getAs('application/pdf');
  file.setTrashed(true);
  return blob;
}

// Navy band: club seal on the left, club name and report title on the right
function _brandHeader(body, subtitle) {
  const band = body.appendTable([['', SACCO_NAME]]);
  band.setBorderWidth(0);
  const left = band.getRow(0).getCell(0);
  const right = band.getRow(0).getCell(1);
  left.setBackgroundColor(BRAND_COLOR); right.setBackgroundColor(BRAND_COLOR);
  left.setWidth(96); right.setWidth(400);
  left.setPaddingTop(10); left.setPaddingBottom(10); left.setPaddingLeft(12);
  right.setPaddingTop(12); right.setPaddingBottom(10); right.setPaddingLeft(10);
  left.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);
  right.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);
  const img = left.getChild(0).asParagraph().appendInlineImage(_logoBlob());
  img.setWidth(70); img.setHeight(70);
  const name = right.getChild(0).asParagraph();
  name.editAsText().setBold(true).setFontSize(15).setForegroundColor('#ffffff');
  const sub = right.appendParagraph(subtitle);
  sub.editAsText().setFontSize(10).setBold(false).setForegroundColor('#dbe7f3');
  body.appendParagraph('').setSpacingAfter(2);
}

function _section(body, text) {
  const p = body.appendParagraph(text);
  p.setSpacingBefore(14); p.setSpacingAfter(4);
  p.editAsText().setFontSize(12).setBold(true).setForegroundColor(BRAND_COLOR);
  return p;
}

// Summary cards: [[label, value], ...] shown side by side
function _cards(body, items) {
  const t = body.appendTable([items.map(i => i[0]), items.map(i => i[1])]);
  t.setBorderWidth(0);
  items.forEach((_, c) => {
    [0, 1].forEach(r => {
      const cell = t.getRow(r).getCell(c);
      cell.setBackgroundColor(BRAND_SOFT);
      cell.setPaddingTop(8); cell.setPaddingBottom(8); cell.setPaddingLeft(10); cell.setPaddingRight(10);
      const p = cell.getChild(0).asParagraph();
      if (r === 0) p.editAsText().setFontSize(8).setBold(true).setForegroundColor(BRAND_MUTED);
      else p.editAsText().setFontSize(13).setBold(true).setForegroundColor(BRAND_COLOR);
    });
  });
  return t;
}

// Label / value pairs with no header row (member details, loan details)
function _kv(body, rows) {
  const t = body.appendTable(rows);
  t.setBorderColor(BRAND_LINE);
  rows.forEach((row, r) => {
    const label = t.getRow(r).getCell(0);
    label.setBackgroundColor(BRAND_SOFT);
    label.getChild(0).asParagraph().editAsText().setFontSize(9).setForegroundColor(BRAND_MUTED);
    t.getRow(r).getCell(1).getChild(0).asParagraph().editAsText().setFontSize(10).setBold(true);
  });
  return t;
}

// Table with a navy header row and striped body rows. rightCols: 0-based columns to right-align.
function _table(body, header, rows, rightCols) {
  const data = rows.length ? rows : [['No records'].concat(header.slice(1).map(() => ''))];
  const values = [header].concat(data);
  const t = body.appendTable(values);
  t.setBorderColor(BRAND_LINE);
  values.forEach((row, r) => {
    row.forEach((_, c) => {
      const cell = t.getRow(r).getCell(c);
      const p = cell.getChild(0).asParagraph();
      if (r === 0) {
        cell.setBackgroundColor(BRAND_COLOR);
        p.editAsText().setFontSize(9).setBold(true).setForegroundColor('#ffffff');
      } else {
        if (r % 2 === 0) cell.setBackgroundColor(BRAND_STRIPE);
        p.editAsText().setFontSize(9);
      }
      if (rightCols && rightCols.indexOf(c) > -1) p.setAlignment(DocumentApp.HorizontalAlignment.RIGHT);
    });
  });
  return t;
}

// Club seal (JPEG, base64) used on printed reports. Source: src/webapp/brand/logo.html
const CLUB_LOGO_B64 = '';
